# Example environment file. Copy to .env and fill in the values:
#
#   cp .env.example .env
#
# Every variable below maps 1:1 to a koanf leaf in internal/config/config.go.
# Anything omitted falls back to the default shown here. Never commit a real
# .env - it is gitignored.

# HTTP server listen address (host:port).
HTTP__ADDRESS=127.0.0.1:3000

# Header carrying the client IP that HTTP__PROXIES is matched against.
HTTP__PROXY_HEADER=X-Forwarded-For

# Comma-separated list of trusted proxy CIDRs. Empty means no proxy is trusted.
HTTP__PROXIES=

# Serve the Swagger UI and the OpenAPI document under /api/v1/docs.
HTTP__OPENAPI__ENABLED=true

# Host written into the served spec. Empty means "take it from the request".
HTTP__OPENAPI__PUBLIC_HOST=

# Base path written into the served spec. Empty keeps /api/v1.
HTTP__OPENAPI__PUBLIC_PATH=

# Telegram bot token from @BotFather. Required.
TELEGRAM__TOKEN=

# Optional SOCKS5/HTTP proxy for outgoing Telegram API calls.
# Empty means a direct connection. Example: socks5://user:password@127.0.0.1:1080
TELEGRAM__PROXY_URL=

# Redis connection URL used for state storage.
REDIS__URL=redis://localhost:6379/0

# HMAC-SHA256 key used to hash phone numbers before they are stored. Required.
# Changing it invalidates every phone number already stored.
STORAGE__SECRET=

# Language used when no translation matches the requested one.
I18N__DEFAULT_LANGUAGE=en

# Directory the i18n JSON translation files are loaded from.
I18N__TRANSLATIONS_PATH=i18n/locales