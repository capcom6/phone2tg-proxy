FROM alpine:3

ARG TARGETPLATFORM
ARG BINARY_NAME

# Install certificates and timezone data
RUN apk add --no-cache ca-certificates tzdata

# Set the Current Working Directory inside the container
WORKDIR /app

# Copy the Pre-built binary file from GoReleaser
COPY $TARGETPLATFORM/$BINARY_NAME ./app

# Copy translation files for internationalization support
COPY i18n/locales ./i18n/locales

# Command to run the executable
ENTRYPOINT ["/app/app"]

# Liveness watchdog: the telegram:api check answers 503 once no getUpdates
# response has completed for 3x TELEGRAM__TIMEOUT. Docker marks the container
# unhealthy; restarting it requires a health-aware orchestrator or watcher.
# The port must match HTTP__ADDRESS (default 3000); shell parameter expansion
# is deliberately avoided because the Dockerfile parser rejects it.
# Alpine's busybox wget treats 503 as an error.
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:3000/health/live || exit 1
